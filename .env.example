APP_NAME=my-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model Config
GROQ_API_KEY=Paste your api here
MODEL=openai/gpt-oss-120b
TEMPERATURE=0

# Comma separated browser origins allowed to call the API (React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Langfuse tracing. Configure both keys to enable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set this for a non-default region or self-hosted Langfuse instance.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Prompt and completion content is masked by default; enable only if approved.
LANGFUSE_CAPTURE_CONTENT=false